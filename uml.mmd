classDiagram
    direction TB

    class User {
        <<abstract>>
        #string userId
        #string fullName
        #string phoneNumber
        #string email
        #string password
        +getUserId() string
        +getFullName() string
        +getPhoneNumber() string
        +getEmail() string
        +getPassword() string
        +verifyPassword(pwd) bool
        +getRole()* string
        +displayProfile()* void
    }

    class Customer {
        -vector~Account*~ accounts
        +getCustomerId() string
        +getAccounts() vector
        +getRole() string
        +displayProfile() void
        +addAccount(account) void
        +removeAccount(number) void
        +findAccount(number) Account*
        +listAccounts(bankId) void
        +getTotalBalance(bankId) double
    }

    class BankStaff {
        -string bankId
        +getStaffId() string
        +getBankId() string
        +getRole() string
        +displayProfile() void
    }

    class Admin {
        +getAdminName() string
        +getRole() string
        +displayProfile() void
        +showBanks(banks) void
    }

    class AuthenticationSystem {
        +registerCustomer(system, name, phone, email, password)$ Customer*
        +registerBankAndStaff(system, bankDetails, staffDetails)$ BankStaff*
        +loginCustomer(system, contact, password)$ Customer*
        +loginStaff(system, contact, password)$ BankStaff*
        +loginAdmin(system, username, password)$ Admin*
    }

    class BankSystem {
        -vector~Bank*~ banks
        -vector~Customer*~ customers
        -vector~BankStaff*~ staffMembers
        -Admin admin
        -int nextCustomerId
        -int nextBankId
        -int nextStaffId
        +BankSystem()
        +~BankSystem()
        +findBank(id) Bank*
        +findBankByName(name) Bank*
        +findCustomer(id) Customer*
        +getBanks() vector
        +getCustomers() vector
        +getStaffMembers() vector
        +getAdmin() Admin
        +showBanks() void
        +save() void
        +run() void
    }

    class Bank {
        -string bankId
        -string bankName
        -string phoneNumber
        -string email
        -string address
        -string status
        -double defaultInterestRate
        -double defaultTransactionFee
        -long nextAccountNumber
        -vector~Customer*~ customers
        +openSavingsAccount(customer, balance, minimum) string
        +openCheckingAccount(customer, balance, limit) string
        +openAccount(customer, account) void
        +findCustomer(customerId) Customer*
        +findAccount(number) Account*
        +deposit(accountNumber, amount) void
        +withdraw(accountNumber, amount) void
        +closeAccount(number) void
        +viewAllCustomers() void
        +updateAllInterestRates(rate) void
        +updateAllTransactionFees(fee) void
        +getBankId() string
        +getBankName() string
        +getStatus() string
        +setStatus(status) void
        +isActive() bool
    }

    class Account {
        <<abstract>>
        -string accountNumber
        -string bankId
        #double balance
        +deposit(amount) void
        +withdraw(amount)* void
        +getAccountNumber() string
        +getBalance() double
        +getBankId() string
        +getType()* string
        +display()* void
    }

    class SavingsAccount {
        -double interestRate
        -double minimumBalance
        +withdraw(amount) void
        +applyInterest() void
        +getType() string
        +display() void
    }

    class CheckingAccount {
        -double overdraftLimit
        -double transactionFee
        +withdraw(amount) void
        +getType() string
        +display() void
    }

    class FileStorage {
        +save(system)$ void
        +load(system)$ void
    }

    class runtime_error
    class BankingException
    class InvalidAmountException
    class InsufficientFundsException
    class AccountNotFoundException

    %% Inheritance
    User <|-- Customer
    User <|-- BankStaff
    User <|-- Admin
    Account <|-- SavingsAccount
    Account <|-- CheckingAccount
    runtime_error <|-- BankingException
    BankingException <|-- InvalidAmountException
    BankingException <|-- InsufficientFundsException
    BankingException <|-- AccountNotFoundException

    %% Ownership and associations
    BankSystem "1" *-- "1..*" Bank : owns
    BankSystem "1" *-- "0..*" Customer : owns
    BankSystem "1" *-- "0..*" BankStaff : owns
    BankSystem "1" *-- "1" Admin : contains
    Bank "0..*" -- "0..*" Customer : references
    Customer "1" *-- "0..*" Account : owns
    BankStaff "0..*" --> "1" Bank : bankId
    Account "0..*" --> "1" Bank : bankId

    %% Service dependencies
    AuthenticationSystem ..> BankSystem : registers through
    AuthenticationSystem ..> User : authenticates
    BankSystem ..> AuthenticationSystem : delegates login
    FileStorage ..> BankSystem : saves and loads

    %% Exception dependencies
    Account ..> InvalidAmountException : throws
    SavingsAccount ..> InsufficientFundsException : throws
    CheckingAccount ..> InsufficientFundsException : throws
    Customer ..> AccountNotFoundException : throws
    Bank ..> BankingException : throws
    FileStorage ..> BankingException : throws

    %% CLI functions are in src/Menus.cpp, not a Menus class.
    %% BankSystem::run() calls runMainMenu(*this).
    %% runtime_error in this diagram represents std::runtime_error.